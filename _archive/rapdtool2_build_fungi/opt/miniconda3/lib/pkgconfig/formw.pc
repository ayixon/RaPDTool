# pkg-config file generated by gen-pkgconfig
# vile:makemode

prefix=/opt/miniconda3
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ncursesw
abi_version=6
major_version=6
version=6.3.20211021

Name: formw
Description: ncurses 6.3 add-on library
Version: ${version}
URL: https://invisible-island.net/ncurses
Requires.private: ncursesw
Libs:  -L/opt/miniconda3/lib -Wl,-O2 -Wl,--sort-common -Wl,--as-needed -Wl,--disable-new-dtags -Wl,--gc-sections -Wl,-rpath,/opt/miniconda3/lib -Wl,-rpath-link,/opt/miniconda3/lib -lformw
Libs.private:  
Cflags:  -D_GNU_SOURCE -I${includedir} -I/opt/miniconda3/include

prefix=/opt/miniconda3
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: libidn2
Description: Library implementing IDNA2008 and TR46
Version: 2.3.2
Cflags: -I${includedir}
Libs: -L${libdir} -lidn2
Libs.private:  -L/opt/miniconda3/lib -lunistring -R/opt/miniconda3/lib

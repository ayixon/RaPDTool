#!/bin/sh
# rapdtool - launcher for the RaPDTool Apptainer image.
#
# Installs no bioinformatics tools: it downloads (once) and caches the prebuilt,
# tested SIF image and the databases, then runs the pipeline inside the image.
#
# First run downloads everything to the cache dir (override with $RAPDTOOL_CACHE):
#     ${XDG_CACHE_HOME:-$HOME/.cache}/rapdtool
#
# Env overrides (all optional):
#   RAPDTOOL_CACHE        cache directory
#   RAPDTOOL_SIF          use this SIF instead of downloading
#   RTMASHDB              use this mash .msh instead of downloading
#   RTFOCUSDB             use this FOCUS db dir (containing db/k6) instead of downloading
#   RAPDTOOL_SIF_URL / RAPDTOOL_MASHDB_URL / RAPDTOOL_FOCUSDB_URL   download sources

set -eu

RAPDTOOL_VERSION=2.3.2

CACHE="${RAPDTOOL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rapdtool}"

# ---- download sources (figshare) --------------------------------------------
# Stable figshare ARTICLE ids (from the DOI 10.6084/m9.figshare.<id>). The exact
# per-file download URL is resolved at run time from the figshare API, so
# uploading a new version of an article keeps working without editing anything.
#   SIF     -> https://doi.org/10.6084/m9.figshare.21375609
#   mash DB -> https://doi.org/10.6084/m9.figshare.21379491
#   FOCUS DB-> https://doi.org/10.6084/m9.figshare.21395619
SIF_ARTICLE="${RAPDTOOL_SIF_ARTICLE:-21375609}"
MASHDB_ARTICLE="${RAPDTOOL_MASHDB_ARTICLE:-21379491}"
FOCUSDB_ARTICLE="${RAPDTOOL_FOCUSDB_ARTICLE:-21395619}"

# Optional hard overrides of the direct download URL (skip API resolution).
SIF_URL="${RAPDTOOL_SIF_URL:-}"
MASHDB_URL="${RAPDTOOL_MASHDB_URL:-}"
FOCUSDB_URL="${RAPDTOOL_FOCUSDB_URL:-}"

SIF="${RAPDTOOL_SIF:-$CACHE/rapdtool_${RAPDTOOL_VERSION}.sif}"
MASHDB_DEFAULT="$CACHE/mash_db.msh"
FOCUSDB_DEFAULT="$CACHE/focus"          # contains db/k6

msg() { printf '[rapdtool] %s\n' "$*" >&2; }
die() { printf '[rapdtool] error: %s\n' "$*" >&2; exit 1; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not found"; }

# resolve the direct download URL of an article's file from the figshare API
figshare_file_url() {  # figshare_file_url ARTICLE_ID
    curl -fsSL "https://api.figshare.com/v2/articles/$1" 2>/dev/null \
        | grep -o '"download_url"[[:space:]]*:[[:space:]]*"[^"]*"' \
        | head -n1 \
        | sed 's/.*"\(https[^"]*\)".*/\1/'
}

fetch() {  # fetch URL DEST
    _url="$1"; _dest="$2"
    [ -n "$_url" ] || die "no download URL for $(basename "$_dest")"
    mkdir -p "$(dirname "$_dest")"
    msg "downloading $(basename "$_dest") ..."
    if command -v curl >/dev/null 2>&1; then
        curl -fL --retry 3 -o "$_dest.part" "$_url" || die "download failed: $_url"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$_dest.part" "$_url" || die "download failed: $_url"
    else
        die "need 'curl' or 'wget' to download files"
    fi
    mv "$_dest.part" "$_dest"
}

# Decide whether DEST must be (re)downloaded and set $SRC to the URL to fetch.
# The figshare per-file id (embedded in the download URL) changes whenever a new
# version of the article is uploaded, so a mismatch with the recorded sidecar
# (.src) triggers a refresh. Offline / API-down keeps the cached copy.
# Returns 0 = fetch, 1 = keep cache.
plan_fetch() {  # plan_fetch DEST SIDECAR OVERRIDE_URL ARTICLE
    _dest="$1"; _side="$2"; _ovr="$3"; _art="$4"; SRC=""
    # fast path: cache present and the per-run update check is disabled
    if [ -e "$_dest" ] && [ -n "${RAPDTOOL_NO_UPDATE_CHECK:-}" ]; then return 1; fi
    if [ -n "$_ovr" ]; then _cur="$_ovr"; else _cur=$(figshare_file_url "$_art"); fi
    SRC="$_cur"
    if [ ! -e "$_dest" ]; then
        [ -n "$SRC" ] || die "could not resolve download URL (figshare article $_art; network?)"
        return 0
    fi
    [ -n "$_cur" ] || return 1                                  # offline -> keep cache
    [ -f "$_side" ] && [ "$(cat "$_side" 2>/dev/null)" = "$_cur" ] && return 1
    msg "a newer version is available; refreshing $(basename "$_dest") ..."
    return 0
}

# The cached image is named after $RAPDTOOL_VERSION, but the download source is a
# fixed figshare article that serves whatever image is current there. If this launcher
# is newer than the published image -- an unreleased build, or a version bump made
# before upload -- the fetch would store the OLD image under the NEW name and every run
# would report a version it is not executing. Compare the image's own label and refuse
# rather than run something mislabelled.
check_sif_version() {
    command -v apptainer >/dev/null 2>&1 || return 0
    _got=$(apptainer inspect "$SIF" 2>/dev/null \
           | sed -n 's/^Version:[[:space:]]*//p' | head -n1)
    [ -n "$_got" ] || return 0                      # unlabelled image, nothing to check
    [ "$_got" = "$RAPDTOOL_VERSION" ] && return 0
    die "image version mismatch: $SIF reports $_got but this launcher is $RAPDTOOL_VERSION.
       The download source (figshare $SIF_ARTICLE) may not carry $RAPDTOOL_VERSION yet.
       Point \$RAPDTOOL_SIF at the matching image, or remove $SIF to re-fetch."
}

ensure_sif() {
    if [ -n "${RAPDTOOL_SIF:-}" ] && [ -f "$SIF" ]; then   # user-provided image
        check_sif_version
        return 0
    fi
    if plan_fetch "$SIF" "$SIF.src" "$SIF_URL" "$SIF_ARTICLE"; then
        fetch "$SRC" "$SIF"
        printf '%s' "$SRC" > "$SIF.src"
    fi
    check_sif_version
}

ensure_mashdb() {
    if [ -n "${RTMASHDB:-}" ] && [ -f "$RTMASHDB" ]; then return 0; fi
    if plan_fetch "$MASHDB_DEFAULT" "$MASHDB_DEFAULT.src" "$MASHDB_URL" "$MASHDB_ARTICLE"; then
        fetch "$SRC" "$MASHDB_DEFAULT"
        printf '%s' "$SRC" > "$MASHDB_DEFAULT.src"
    fi
    RTMASHDB="$MASHDB_DEFAULT"
}

ensure_focusdb() {
    if [ -n "${RTFOCUSDB:-}" ] && [ -f "$RTFOCUSDB/db/k6" ]; then return 0; fi
    if plan_fetch "$FOCUSDB_DEFAULT/db/k6" "$FOCUSDB_DEFAULT/.src" "$FOCUSDB_URL" "$FOCUSDB_ARTICLE"; then
        rm -rf "$FOCUSDB_DEFAULT"
        fetch "$SRC" "$CACHE/focus_db.tar.gz"
        msg "extracting FOCUS database ..."
        mkdir -p "$CACHE"
        tar -xzf "$CACHE/focus_db.tar.gz" -C "$CACHE" || die "could not extract focus_db.tar.gz"
        rm -f "$CACHE/focus_db.tar.gz"
        [ -f "$FOCUSDB_DEFAULT/db/k6" ] || die "FOCUS db/k6 not found after extraction"
        printf '%s' "$SRC" > "$FOCUSDB_DEFAULT/.src"
    fi
    RTFOCUSDB="$FOCUSDB_DEFAULT"
}

add_bind() {  # add parent dir of $1 to APPTAINER_BIND (deduplicated)
    _p=$(readlink -f "$1" 2>/dev/null) || return 0
    [ -n "$_p" ] || return 0
    _d=$(dirname "$_p")
    [ -d "$_d" ] || return 0
    case ",${APPTAINER_BIND:-}," in
        *",$_d,"*) : ;;
        *) APPTAINER_BIND="${APPTAINER_BIND:+$APPTAINER_BIND,}$_d" ;;
    esac
}

usage() {
    cat <<EOF
==============================================
(Ra)pid (P)rofiling and (D)econvolution (Tool)
    Ayixon Sanchez-Reyes and Karel Estrada
           RaPDTool - Version $RAPDTOOL_VERSION
==============================================

Usage:
  rapdtool -i INPUT [-o OUTPUT] [-m {full,profile,screen}] [-t THREADS] [-a COVERAGE]
           [--screen-identity F] [--screen-genus-identity F] [--no-split-bins] [--force] [-c COMMENT]

  -i, --input      input FASTA assembly (.fasta/.fa/.fna/.fas, optionally .gz)   [required]
                   (screen mode also accepts FASTQ reads: .fastq/.fq[.gz];
                    one file only — cat paired/multi-lane FASTQ together first)
  -o, --output     output directory (default: ./rapdtool_results)
  -m, --mode       full (default): binning + per-bin classification;
                   profile: single genome (FOCUS + whole-assembly Mash);
                   screen: FOCUS + mash-screen containment (what's there, no binning)
  -t, --threads    threads for FOCUS/Metabat/miComplete/Mash (default: all cores)
  -a, --coverage   depth/coverage file passed to Metabat2 (-a)
      --screen-identity   min mash-screen identity for a SPECIES call in screen mode
                          (default: 0.95 = Mash distance 0.05)
      --screen-genus-identity   min identity for a GENUS call in screen mode
                          (default: 0.92 = distance 0.08; same band as full mode)
      --no-split-bins   disable per-species FASTA output
      --force      overwrite existing results for the same input
  -c, --comment    comment recorded in the log

  -d, --database   mash .msh to use instead of the cached one    (optional override)
      --focus-db   FOCUS db directory (containing db/k6) to use  (optional override)

Launcher commands:
  rapdtool setup      pre-download the image and databases into the cache
  rapdtool update     force re-download of the image and databases
  rapdtool --where    show cache locations
  rapdtool --help     this help

On first use the image (~0.5 GB) and databases are downloaded to:
  $CACHE
(override with \$RAPDTOOL_CACHE). Each run checks figshare and re-downloads an asset
when a newer version is published (set \$RAPDTOOL_NO_UPDATE_CHECK=1 to skip the check).
Databases are auto-provided; set \$RTMASHDB / \$RTFOCUSDB to use your own.
EOF
}

case "${1:-}" in
    -h|--help|help|"") usage; exit 0 ;;
    -V|--version)      echo "rapdtool $RAPDTOOL_VERSION"; exit 0 ;;
    --where)
        echo "cache:   $CACHE"
        echo "sif:     $SIF"
        echo "mashdb:  ${RTMASHDB:-$MASHDB_DEFAULT}"
        echo "focusdb: ${RTFOCUSDB:-$FOCUSDB_DEFAULT}"
        exit 0 ;;
    setup)
        need_cmd apptainer
        ensure_sif; ensure_focusdb; ensure_mashdb
        msg "setup complete — cache: $CACHE"; exit 0 ;;
    update)
        need_cmd apptainer
        # only clear cache-managed assets, never user-provided overrides
        [ -n "${RAPDTOOL_SIF:-}" ] || rm -f "$SIF" "$SIF.src"
        [ -n "${RTMASHDB:-}" ]     || rm -f "$MASHDB_DEFAULT" "$MASHDB_DEFAULT.src"
        [ -n "${RTFOCUSDB:-}" ]    || rm -rf "$FOCUSDB_DEFAULT"
        ensure_sif; ensure_focusdb; ensure_mashdb
        msg "update complete — cache: $CACHE"; exit 0 ;;
esac

need_cmd apptainer
ensure_sif
ensure_focusdb        # required by the image (FOCUS db is not bundled)
ensure_mashdb         # auto-provided; used by full mode and profile+mash

APPTAINER_BIND="${APPTAINER_BIND:-}"
add_bind "$RTMASHDB"
add_bind "$RTFOCUSDB/db"
_prev=""
for _arg in "$@"; do
    case "$_prev" in
        -i|--input|-d|--database|--focus-db|-a|--coverage|-o|--output) add_bind "$_arg" ;;
    esac
    _prev="$_arg"
done
export APPTAINER_BIND
export APPTAINERENV_RTMASHDB="$RTMASHDB"
export APPTAINERENV_RTFOCUSDB="$RTFOCUSDB"

exec apptainer --quiet run "$SIF" "$@"    # --quiet hides benign INFO (e.g. fuse2fs); keeps warnings/errors
